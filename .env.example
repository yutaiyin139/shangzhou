# ============================================
# 熵舟·智能工作台 - 环境配置模板
#
# 使用方法:
#   1. 复制此文件为 .env
#   2. 修改下面的配置值
#   3. 重启服务生效
# ============================================

# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# 请填入你的数据库密码（切勿把真实密码提交到仓库）
DB_PASSWORD=
DB_NAME=szagent

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT 认证 =====
# 生产环境必须设置（32字符以上随机字符串）
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=7200
JWT_REFRESH_EXPIRY=604800

# ===== 加密密钥 =====
# 用于加密 API Key 等敏感数据（自动生成或手动设置）
ENCRYPTION_KEY=

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=logs/backend.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=10

# ===== Flask 配置 =====
FLASK_DEBUG=0
SECRET_KEY=your_flask_secret_here

# ===== Celery 配置 =====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===== Marketplace（可选）=====
MARKETPLACE_API_BASE=https://marketplace.dify.ai/api/v1
MARKETPLACE_SYNC_ALL=true
