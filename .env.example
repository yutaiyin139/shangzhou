# ============================================
# 熵舟·智能工作台 - 环境配置模板
#
# 使用方法:
#   1. 复制此文件为 .env
#   2. 修改下面的配置值
#   3. 重启服务生效
# ============================================

# ===== 数据库配置 =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# 请填入你的数据库密码（切勿把真实密码提交到仓库）
DB_PASSWORD=
DB_NAME=szagent

# ===== Redis 配置 =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT 认证 =====
# 生产环境必须设置（32字符以上随机字符串）
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=7200
JWT_REFRESH_EXPIRY=604800

# ===== 加密密钥 =====
# 用于加密 API Key 等敏感数据（自动生成或手动设置）
ENCRYPTION_KEY=

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=logs/backend.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=10

# ===== Flask 配置 =====
FLASK_DEBUG=0
SECRET_KEY=your_flask_secret_here

# ===== Celery 配置 =====
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ===== Marketplace（可选）=====
MARKETPLACE_API_BASE=https://marketplace.dify.ai/api/v1
MARKETPLACE_SYNC_ALL=true

# ===== 登录失败锁定（安全）=====
# 防暴力破解：账号 5/10/20 次失败 -> 15分钟/1小时/24小时；IP 20/50 次 -> 30分钟/2小时。
# 仅开发/调试阶段可置 false 临时关闭；生产环境必须保持 true（缺省即启用）。
LOGIN_LOCKOUT_ENABLED=true

# ===== 前端登录图形验证码 =====
# 与后端 LOGIN_LOCKOUT_ENABLED 同由本文件控制：Vite 仅注入 VITE_ 前缀变量，
# DB_PASSWORD / JWT_SECRET / ENCRYPTION_KEY 等不会进入浏览器包。
# 开发阶段可置 false 跳过验证码；生产环境必须保持 true（缺省即启用）。
VITE_LOGIN_CAPTCHA=true

# ===== Celery 队列库编号（未显式给 CELERY_*_URL 时用于拼接 broker/result 连接串）=====
# 取自 backend/tasks/celery_app.py
REDIS_DB_BROKER=0
REDIS_DB_BACKEND=1

# ===== 对象存储（文件上传；local=本地磁盘，minio=MinIO/S3 兼容）=====
# 取自 backend/utils/storage.py；仅当 STORAGE_TYPE=minio 时下列 MINIO_* 生效
# 注：minioadmin/minioadmin 是 MinIO 出厂默认账号，生产环境必须更换。
STORAGE_TYPE=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=shangzhou
MINIO_REGION=us-east-1
MINIO_SECURE=false

# ===== 备份（本地全量备份目录 + 可选远程备份）=====
# 取自 backend/routes/backup.py 与 backend/tasks/backup_task.py
BACKUP_DIR=/var/lib/szagent/backups
UPLOAD_DIR=/var/lib/szagent/uploads
CONFIG_DIR=/opt/szagent
REMOTE_BACKUP_ENABLED=false
# 远程备份后端：s3 / sftp / oss
REMOTE_BACKEND=s3
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=szagent/backups/
SFTP_BACKUP_HOST=
SFTP_BACKUP_PATH=/backups/szagent/
SFTP_USER=backup
SFTP_PASS=

# ===== Rerank 重排模型（可选；RERANK_API_KEY 留空则走多级回退）=====
RERANK_API_URL=https://api.jina.ai/v1/rerank
RERANK_API_KEY=
RERANK_MODEL=jina-reranker-v1-base-en

# ===== 邮件（工作流 Human Input 表单投递 / email 内置工具）=====
# SMTP 发送账号与收件 IMAP 配置；取自 backend/engine/tool_runtime.py
EMAIL_USERNAME=
EMAIL_PASSWORD=
IMAP_HOST=
IMAP_PORT=993

# ===== OAuth / SSO 回调基址 =====
# 取自 backend/utils/oauth_user.py，用于拼接 /api/oauth/callback 回调 URL；
# 生产必须改为对外可访问地址（如 https://ai.example.com）
APP_BASE_URL=http://localhost:5000

# ===== 内置工具：图片生成（可选；IMAGE_GEN_API_KEY 留空则回退 OPENAI_API_KEY）=====
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_API_KEY=
OPENAI_API_KEY=

# ===== Tracing 可观测性（可选，默认关闭）=====
# TRACING_BACKEND 可选：langfuse / langsmith / opik / webhook
TRACING_ENABLED=false
TRACING_BACKEND=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=entropy-boat
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
OPIK_API_KEY=
OPIK_WORKSPACE=entropy-boat
OPIK_PROJECT=entropy-boat
OPIK_URL=https://www.comet.com/opik/api
TRACING_WEBHOOK_URL=
TRACING_WEBHOOK_HEADERS={}

# ===== 端到端测试专用（仅 backend/tests/e2e_auth_helper.py 使用；勿填生产凭据）=====
SHANGZHOU_TEST_BASE_URL=http://localhost:5000
SHANGZHOU_TEST_USERNAME=
SHANGZHOU_TEST_PASSWORD=
